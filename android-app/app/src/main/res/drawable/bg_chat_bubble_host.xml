<?xml version="1.0" encoding="utf-8"?>
<!-- Burbuja de un mensaje que ha escrito el propio anfitrión (esta app) —
     resaltada con el mismo amarillo que el resto de "encendido" en la UI, para
     que se distinga de un vistazo de los mensajes de los espectadores. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android">
    <solid android:color="#2B2607" />
    <stroke android:width="1dp" android:color="@color/state_on" />
    <corners android:radius="12dp" />
</shape>
